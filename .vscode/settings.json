{
    // ==========================================
    // GLOBAL
    // ==========================================
    "editor.formatOnSave": true,
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "files.trimTrailingWhitespace": true,

    // ==========================================
    // WAMP PHP PATH  (CHANGE VERSION IF NEEDED)
    // ==========================================
    "php.validate.executablePath": "C:\\wamp64\\bin\\php\\php8.4.11\\php.exe",

    // Disable built-in PHP suggestions (use Intelephense)
    "php.suggest.basic": false,

    // ==========================================
    // INTELEPHENSE (Performance Optimized)
    // ==========================================
    "intelephense.environment.phpVersion": "8.1",
    "intelephense.files.maxSize": 5000000,
    "intelephense.files.exclude": [
        "**/vendor/**",
        "**/node_modules/**",
        "**/storage/**",
        "**/bootstrap/cache/**"
    ],
    "intelephense.environment.includePaths": [
        "vendor"
    ],
    "intelephense.diagnostics.undefinedTypes": false,
    "intelephense.diagnostics.undefinedFunctions": false,
    "intelephense.diagnostics.undefinedConstants": false,
    // ==========================================
    // FORMATTERS
    // ==========================================
    "[php]": {
         "editor.defaultFormatter": "open-sourcerers.laravel-pint"
    },
    "[blade]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[html]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[css]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },

    // ==========================================
    // BLADE + EMMET
    // ==========================================
    "emmet.includeLanguages": {
        "blade": "html"
    },
    "html.autoClosingTags": true,

    // ==========================================
    // CSS
    // ==========================================
    "css.validate": true,

    // ==========================================
    // PHPUnit (Uses WAMP PHP)
    // ==========================================
    "phpunit.command": "vendor/bin/phpunit",

    // ==========================================
    // SEARCH / EXCLUDE
    // ==========================================
    "files.exclude": {
        "**/vendor": true,
        "**/node_modules": true
    },
    "search.exclude": {
        "**/vendor": true,
        "**/node_modules": true
    },

    // ==========================================
    // TERMINAL
    // ==========================================
    "terminal.integrated.defaultProfile.windows": "Command Prompt"
}